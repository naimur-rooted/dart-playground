app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# =====================================================================
# Assignment-showcase filters (added for the course submission)
# Keep this repo focused on the app source, tests and docs only.
#
# The folders ignored below are generated by `flutter create` and are
# NOT required to demonstrate the assignment. They remain on disk for
# local development; a fresh clone can regenerate them with:
#
#   flutter create . --project-name assigment_on_module_13
#
# =====================================================================
# Flutter tooling metadata / IDE files
/.metadata
/.idea/
/.vscode/

# Generated platform scaffolding (boilerplate)
/android/
/ios/
/linux/
/macos/
/windows/
/web/

# Locally generated runtime logs (e.g. `flutter run` in the background)
/*.log
/flutter_run_pid.txt

# Original screenshot JPEGs kept for the user (README uses screenshots/*.png)
/docs/
