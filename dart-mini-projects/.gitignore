# =============================================
# Dart-Playground flutter-mini-projects root ignore
# =============================================

# --- Essential source files kept:
# - README.md
# - pubspec.yaml / pubspec.lock
# - analysis_options.yaml
# - lib/**           (Dart source code)
# - test/**          (unit / widget tests)
# - screenshots/**   (assignment screenshots)

# ------------------------------------------------------------------
# Ignore everything else so we only ship the assignment showcase
# ------------------------------------------------------------------

# --- Flutter / Dart tooling / IDE metadata ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
.dart-tool/
.metadata

# IDE folders
.idea/
.vscode/
*.iml
*.iws
*.ipr

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# Local properties (machine-specific paths)
local.properties
**/local.properties

# Logs
*.log
flutter_log.txt

# Build / coverage
build/
.coverage/
coverage/

# Generated platform scaffolding (boilerplate, can be regenerated)
# We keep app assets, README and source but ignore the platform-specific
# generated folders that are not needed to showcase a Flutter assignment.
/android/app/src/
/android/app/build.gradle.kts
/android/gradle.properties
/android/app/build.gradle
/android/app/proguard-rules.pro
/android/app/google-services.json
/android/app/key.properties
/android/app/keys.jks

/ios/
/linux/
/macos/
/windows/
/web/

# Android generated artifacts (not in /android/app/build.gradle.kts above)
/android/.gradle/
/android/gradle/wrapper/
/android/gradle/libs.versions.toml

# Generated files
**/generated_plugin_registrant*
**/generated_plugins.cmake
**/generated_plugin_registrant.{cc,h}
**/App.framework
**/Flutter.framework
**/Flutter.podspec
**/App.podspec
**/flutter_export_environment.sh
**/flutter_assets/
**/symlinks/
**/Flutter/Config/Generated.xcconfig
**/Flutter/App.framework/
**/Flutter/flutter_assets/
**/Flutter/flutter_export_environment.sh

# CocoaPods
**/Pods/
**/Podfile.lock

# Gradle
.gradle/
**/build/
**/app/build/
**/bin/
**/obj/
**/out/

# Debug / profile / release artifacts
/android/app/debug/
/android/app/profile/
/android/app/release/

# Flutter inspector / timeline
.inspector/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Miscellaneous generated files
**/doc/api/
**/ios/Flutter/.last_build_id

# Keep dart-mini-projects/README.md but ignore sub-readme if not needed
# (this file intentionally commented out)
# /README.md

# Module-specific ignores
# Assignment_on_Module_12 has extra Android files we don't need
/Assignment_on_Module_12/.gradle/
/Assignment_on_Module_12/.metadata

# Assignment_on_Module_14 has platform folders generated by 'flutter create'
/Assignment_on_Module_14/.idea/

# Screenshots we want to keep (don't ignore)
# /Assigment_on_Module_13/screenshots/
# /Assigment_on_Module_13/README.md