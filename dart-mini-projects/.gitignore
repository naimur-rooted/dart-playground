# =============================================
# Dart-Playground flutter-mini-projects root ignore
# =============================================

# --- Essential source files kept:
# - README.md
# - pubspec.yaml / pubspec.lock
# - analysis_options.yaml
# - lib/**           (Dart source code)
# - test/**          (unit / widget tests)
# - screenshots/**   (assignment screenshots)

# ------------------------------------------------------------------
# Ignore everything else so we only ship the assignment showcase
# ------------------------------------------------------------------

# --- Flutter / Dart tooling / IDE metadata ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
.dart-tool/
.metadata

# IDE folders
.idea/
.vscode/
*.iml
*.iws
*.ipr

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# Local properties (machine-specific paths)
local.properties
**/local.properties

# Logs
*.log
flutter_log.txt

# Build / coverage
build/
.coverage/
coverage/

# --- Platform-specific scaffolding (boilerplate, can be regenerated) ---
# We keep app source code, README and tests but ignore platform-specific
# generated folders that are not needed to showcase a Flutter assignment.

# Android project files (gradle build files, manifest, resources)
android/
**/.gradle/
**/gradle-wrapper.properties
**/gradlew
**/gradlew.bat
**/build.gradle.kts
**/build.gradle
**/settings.gradle.kts
**/gradle.properties
**/proguard-rules.pro
**/google-services.json
**/key.properties
**/keys.jks

# iOS project files
ios/
**/Podfile
**/Podfile.lock
**/Pods/
**/App.framework/
**/Flutter.framework/
**/Flutter.podspec
**/App.podspec
**/flutter_export_environment.sh
**/flutter_assets/
**/symlinks/
**/Runner.xcodeproj/
**/Runner.xcworkspace/

# Linux project files
linux/

# macOS project files
macos/

# Windows project files
windows/

# Web project files
web/

# Generated files
**/generated_plugin_registrant*
**/generated_plugins.cmake
**/doc/api/

# Flutter inspector / timeline
.inspector/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# App-level gradle files (in Module 12)
**/app/build.gradle.kts
**/app/.gitignore